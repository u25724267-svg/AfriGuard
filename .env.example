# =============================================================================
# AfriGuard Pipeline — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# --- OpenAI (Primary LLM) ---
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=

# --- Anthropic (Optional secondary LLM) ---
ANTHROPIC_API_KEY=

# --- Google (Optional tertiary LLM) ---
GOOGLE_API_KEY=

# --- Database ---
# SQLite (default for PoC — zero infra)
DATABASE_URL=sqlite:///./afriguard.db
# PostgreSQL (production — uncomment and fill in)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/afriguard

# --- Local Storage ---
DATA_DIR=./data

# --- Object Store (optional — set to 's3' or 'gcs' for cloud) ---
OBJECT_STORE_TYPE=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=afriguard-data
# AWS_REGION=us-east-1

# --- Pipeline Behaviour ---
PIPELINE_DEFAULT_MODEL=gpt-4o
PIPELINE_BATCH_SIZE=10
PIPELINE_CANDIDATES_PER_PROMPT=4
POC_MAX_ITEMS_PER_LANGUAGE=100
PIPELINE_SIMILARITY_THRESHOLD=0.85
PIPELINE_MIN_QUALITY_SCORE=0.6

# --- Review UI ---
REVIEW_UI_HOST=0.0.0.0
REVIEW_UI_PORT=8000
# Change this to a random secret string in production
REVIEW_UI_SECRET_KEY=change-me-to-a-random-secret-in-production
PASS_SHONA=

# --- Logging ---
LOG_LEVEL=INFO
# 'console' for development, 'json' for production/CI
LOG_FORMAT=console

# --- MLflow (Optional experiment tracking) ---
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=afriguard-poc

# --- HuggingFace ---
# Set if you need authenticated access to gated datasets
HF_TOKEN=
