# =============================================================================
# AfriGuard Pipeline — Environment Configuration
# Copy this file to the project root as .env and fill in your values.
# Do not place .env inside venv/ or any other directory; AfriGuard only loads ./.env.
# Never commit .env to version control.
# =============================================================================

# --- OpenAI (Primary LLM) ---
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=

# --- Anthropic (Optional secondary LLM) ---
ANTHROPIC_API_KEY=

# --- Google (Optional tertiary LLM) ---
GOOGLE_API_KEY=

# --- Database ---
# SQLite (default for PoC — zero infra)
DATABASE_URL=sqlite:///./afriguard.db
# PostgreSQL (recommended for parallel generation and Batch API workflows)
# DATABASE_URL=postgresql+psycopg2://afriguard:afriguard_dev@127.0.0.1:5432/afriguard

# --- Local Storage ---
DATA_DIR=./data

# --- Object Store (optional — set to 's3' or 'gcs' for cloud) ---
OBJECT_STORE_TYPE=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=afriguard-data
# AWS_REGION=us-east-1

# --- Pipeline Behaviour ---
# Generation defaults live in configs/generation.yaml. These override them for
# deployment-specific runs.
PIPELINE_DEFAULT_MODEL=gpt-5.4
PIPELINE_BATCH_SIZE=10
PIPELINE_CANDIDATES_PER_PROMPT=4
POC_MAX_ITEMS_PER_LANGUAGE=100

# --- Generation Policy Overrides ---
# Defaults live in configs/generation.yaml. Set these only when you need
# deployment-specific overrides.
GENERATION_SAFE_FRACTION=0.50
GENERATION_PROMPT_TEMPERATURE=0.9
GENERATION_PROMPT_MAX_TOKENS=256
GENERATION_RESPONSE_TEMPERATURE=0.9
GENERATION_RESPONSE_MAX_TOKENS=1024

# --- Legal Grounding Overrides ---
# Defaults live in configs/legal_grounding.yaml. Set these only when you need
# deployment-specific overrides.
LEGAL_GROUNDING_ENABLED=true
LEGAL_GROUNDING_INCLUDE_SUMMARIES=true
LEGAL_GROUNDING_INCLUDE_REGISTRY_REFERENCES=true
LEGAL_GROUNDING_FALLBACK_TO_GENERIC=true
LEGAL_GROUNDING_MAX_CHARS=1200

# --- Seed Context Overrides ---
# Defaults live in configs/seed_context.yaml. Set these only when you need
# deployment-specific overrides.
SEED_CONTEXT_N_SEEDS=5
SEED_CONTEXT_MAX_EXCERPT_CHARS=400
SEED_CONTEXT_EXACT_MATCH_POOL_MULTIPLIER=5
SEED_CONTEXT_LANGUAGE_FALLBACK_POOL_MULTIPLIER=3
SEED_CONTEXT_FALLBACK_TO_LANGUAGE=true
SEED_CONTEXT_SHUFFLE=true
SEED_CONTEXT_ENABLED=true

# --- Export Policy Overrides ---
# Defaults live in configs/export.yaml. Set these only when you need
# deployment-specific overrides.
EXPORT_WRITE_NATIVE_JSONL=true
EXPORT_WRITE_PKU_STYLE_JSONL=true
EXPORT_WRITE_ALL_LANGUAGES=true
EXPORT_WRITE_DATASET_CARD=true

# --- Filtering Policy Overrides ---
# Defaults live in configs/filtering.yaml. Set these only when you need
# deployment-specific overrides.
PIPELINE_SIMILARITY_THRESHOLD=0.85
PIPELINE_MIN_QUALITY_SCORE=0.6
PIPELINE_DEDUPLICATION_THRESHOLD=0.70
LANGUAGE_DETECTION_DEFAULT_THRESHOLD=0.40
LANGUAGE_DETECTION_LOW_RESOURCE_THRESHOLD=0.35
LANGUAGE_DETECTION_LIBRARY_ACCEPT_THRESHOLD=0.50
LANGUAGE_DETECTION_MIN_TEXT_CHARS=10
LANGUAGE_DETECTION_LLM_FAILURE_CONFIDENCE=0.40

# --- Review Sampling Overrides ---
# Defaults live in configs/review_sampling.yaml. Set these only when you need
# deployment-specific overrides.
REVIEW_SAMPLE_N_PER_LANGUAGE=50
REVIEW_SAMPLE_BORDERLINE_FRACTION=0.20
REVIEW_SAMPLE_BORDERLINE_MARGIN=0.15

# --- Review UI ---
REVIEW_UI_HOST=127.0.0.1
REVIEW_UI_PORT=8000
PIPELINE_MONITOR_HOST=127.0.0.1
PIPELINE_MONITOR_PORT=8010
REVIEW_UI_TASKS_PER_PAGE=10
AFRIGUARD_ENV=development
# Generate a random 32+ character value before sharing the review UI.
# If left blank, local sessions use a temporary per-process key.
REVIEW_UI_SECRET_KEY=
# Reviewers select their language and are signed in without a password.
# Admin remains password-protected for escalations and privileged views.
PASS_ADMIN=

# --- Logging ---
LOG_LEVEL=INFO
# 'console' for development, 'json' for production/CI
LOG_FORMAT=console

# --- MLflow (Optional experiment tracking) ---
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=afriguard-poc

# --- HuggingFace ---
# Set if you need authenticated access to gated datasets
HF_TOKEN=
